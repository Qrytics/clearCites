# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scholargraph

# ── Semantic Scholar (optional – increases rate limit) ──────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── CrossRef polite pool (optional) ────────────────────────────────────────
CROSSREF_MAILTO=your@email.com

# ── OpenAlex (recommended for Discover UI — improves rate limits) ───────────
# https://docs.openalex.org/how-to-use/api#polite-pool
OPENALEX_MAILTO=your@email.com
# Optional: retry count for 429/502/503 (default 3); base backoff seconds (default 0.75)
# OPENALEX_MAX_RETRIES=3
# OPENALEX_RETRY_BACKOFF_SEC=0.75

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
